# capgo 运行配置（systemd EnvironmentFile）
#
# 安装：install -m 0600 -o root -g root deploy/capgo.env.example /etc/capgo/capgo.env
# 然后替换全部 <...> 占位符。
#
# 生成密钥：
#   CAPGO_MASTER_KEY : openssl rand -hex 32        （独立备份，丢失即密文不可恢复）
#   CAPGO_ADMIN_KEY  : openssl rand -base64 24
#
# 注意：本文件含机密，权限必须 0600，且不得进入版本库。

# 只监听回环，由 Caddy 反代
CAPGO_ADDR=127.0.0.1:3000
CAPGO_DB_PATH=/var/lib/capgo/capgo.sqlite3

# 公开 URL：https 前缀会让管理会话 cookie 自动加 Secure
CAPGO_PUBLIC_URL=https://cap.example.com

# 32 字节 master key（hex 或 base64），用于加密站点 siteverify secret 与
# format-2 签名密钥。与数据库分开备份，二者缺一不可恢复。
CAPGO_MASTER_KEY=<openssl rand -hex 32>

# 管理面板登录密钥（高熵随机值）
CAPGO_ADMIN_KEY=<openssl rand -base64 24>

# 可信反代网段：配置后才会读取 X-Forwarded-For；直连部署请留空
CAPGO_TRUST_PROXY=127.0.0.1/8,::1/128

CAPGO_LOG_LEVEL=info

# 仅用于首次启动 bootstrap 首个站点（之后以数据库/管理面板为准）
# CAPGO_SITE_SLUG=twikoo
# CAPGO_SITE_SECRET=<首次启动时生成或指定，之后从管理面板获取>
